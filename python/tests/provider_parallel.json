{
  "version": "1.0",
  "name": "provider_parallel",
  "entrypoint": "dispatch",
  "limits": {
    "max_steps": 100,
    "max_depth": 10,
    "timeout_seconds": 1800
  },
  "nodes": {
    "dispatch": {
      "type": "fork",
      "branches": {
        "catalog": "fetch_catalog",
        "pricing": "fetch_pricing"
      },
      "join": "combine"
    },
    "fetch_catalog": {
      "type": "task",
      "handler": "demo.fetch_catalog"
    },
    "fetch_pricing": {
      "type": "task",
      "handler": "demo.fetch_pricing"
    },
    "combine": {
      "type": "join",
      "mode": "all",
      "on_failure": "fail",
      "outputs": {
        "catalog": "$.branches.catalog.result",
        "pricing": "$.branches.pricing.result"
      },
      "next": "check_budget"
    },
    "check_budget": {
      "type": "decision",
      "evaluator": "expression",
      "condition": {
        "lt": [
          { "var": "$.run.steps_used" },
          { "var": "$.run.max_steps" }
        ]
      },
      "routes": {
        "true": "evaluate",
        "false": "end_incomplete"
      }
    },
    "evaluate": {
      "type": "decision",
      "evaluator": "provider",
      "provider": "mock.decision",
      "prompt_key": "demo.assessment",
      "input": {
        "catalog": "$.combine.catalog",
        "pricing": "$.combine.pricing"
      },
      "choices": ["sufficient", "insufficient", "uncertain"],
      "routes": {
        "sufficient": "summarize",
        "insufficient": "refine",
        "uncertain": "inspect"
      }
    },
    "refine": {
      "type": "task",
      "handler": "demo.refine",
      "next": "dispatch"
    },
    "inspect": {
      "type": "task",
      "handler": "demo.inspect",
      "next": "evaluate"
    },
    "summarize": {
      "type": "task",
      "handler": "demo.summarize",
      "next": "end_complete"
    },
    "end_complete": {
      "type": "end",
      "status": "completed"
    },
    "end_incomplete": {
      "type": "end",
      "status": "incomplete"
    }
  }
}
