{
  "schema_version": 1,
  "scale": 1.0,
  "provider_rate_limits": [1, 3, 8],
  "concurrency_levels": [1, 4, 8, 16, 32, 64],
  "target_queue_ms": 400,
  "quality_gate": {
    "min_items": 5,
    "min_accuracy": 0.8,
    "min_coverage": 0.8,
    "max_false_support": 0.2
  },
  "scenarios": {
    "heavy_straggler": {
      "straggler_extra_ms": 2000,
      "provider_limit": 3,
      "concurrency": 8
    },
    "quality_stop": {
      "provider_limit": 3,
      "concurrency": 8
    },
    "count_stop": {
      "provider_limit": 3,
      "concurrency": 8,
      "after_verified": 25
    }
  }
}
